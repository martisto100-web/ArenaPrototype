# Auto-normalise line endings on commit; check out native on each OS.
* text=auto

# Unity source / text assets
*.cs               text diff=csharp
*.shader           text
*.cginc            text
*.hlsl             text
*.json             text
*.md               text
*.txt              text
*.uxml             text
*.uss              text

# Unity YAML assets — treat as text, use Unity's smart merge tool
*.unity            text merge=unityyamlmerge eol=lf
*.prefab           text merge=unityyamlmerge eol=lf
*.asset            text merge=unityyamlmerge eol=lf
*.meta             text merge=unityyamlmerge eol=lf
*.controller       text merge=unityyamlmerge eol=lf
*.anim             text merge=unityyamlmerge eol=lf
*.mat              text merge=unityyamlmerge eol=lf
*.inputactions     text

# Binary assets (never try to diff/merge)
*.png              binary
*.jpg              binary
*.jpeg             binary
*.gif              binary
*.psd              binary
*.tga              binary
*.fbx              binary
*.obj              binary
*.wav              binary
*.mp3              binary
*.ogg              binary
*.ttf              binary
*.otf              binary
*.dll              binary
*.wlt              binary

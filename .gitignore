# ---- Unity generated folders ----
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# ---- Visual Studio / Rider / IDE ----
.vs/
.idea/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---- Rider / editor scratch ----
*.tmp
*.TMP
*~
*.swp

# ---- OS files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Unity crash reports & build artifacts ----
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# ---- Asset Store tools ----
/[Aa]ssets/AssetStoreTools*
